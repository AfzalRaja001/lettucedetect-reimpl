# Data - downloaded/generated on each machine, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model weights and training artifacts
checkpoints/*
!checkpoints/.gitkeep
runs/
wandb/
*.safetensors
*.bin
*.pt
*.ckpt

# Results that are regenerated by scripts, not hand-authored
results/*.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
