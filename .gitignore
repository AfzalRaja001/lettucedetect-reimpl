# Data - downloaded/generated on each machine, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model weights and training artifacts
checkpoints/*
!checkpoints/.gitkeep
runs/
wandb/
*.safetensors
*.bin
*.pt
*.ckpt

# (results/*.json is intentionally NOT ignored - metrics.json is the whole
# point of a multi-hour GPU run and needs to sync between machines via git,
# unlike data/ and checkpoints/ which are cheap or too large to regenerate
# identically anyway)

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
